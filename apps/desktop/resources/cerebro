def bank_cli(repo):
    """The CLI to teach for a bank: its own embedded copy when it carries one
    (stable path, self-updating), else the copy running right now."""
    cli = Path(repo) / "bin" / SHIM_NAME
    return cli if cli.is_file() else Path(__file__).resolve()


