def cmd_list(args):
    repo = repo_root()
    items = []
    for path, mem, errors, warnings in load_bank(repo):
        if mem is None:
            items.append({"file": str(path.relative_to(repo)), "errors": errors})
            continue
        items.append({"name": mem.name, "description": mem.description,
                      "metadata": mem.metadata, "body": mem.body,
                      "file": str(path.relative_to(repo)),
                      "org": mem.org, "project": mem.project,
                      "tree": "memories", "readonly": False,
                      "errors": errors, "warnings": warnings})
    if not getattr(args, "bank_only", False):
        for path, mem, _, warnings in load_mirror_trees(repo):
            items.append({"name": mem.name, "description": mem.description,
                          "metadata": mem.metadata, "body": mem.body,
                          "file": str(path.relative_to(repo)),
                          "org": mem.org, "project": mem.project,
                          "tree": mem.tree, "readonly": True,
                          "errors": [], "warnings": warnings})
    items.sort(key=lambda it: ((it.get("org") or "~"), (it.get("project") or "~"),
                               it.get("name") or it.get("file", "")))
    if args.json:
        print(json.dumps(items, indent=2))
        return
    last = object()
    for it in items:
        group = (it.get("org"), it.get("project"))
        if group != last:
            title = " / ".join(p for p in group if p) or "unfiled"
            print(f"[{title}]")
            last = group
        mtype = it.get("metadata", {}).get("type", "?")
        ro = " (read-only)" if it.get("readonly") else ""
        print(f"  {it.get('name', it['file'])} [{mtype}]{ro} — {it.get('description', '')}")


def ask(prompt, default=None, choices=None, assume=None):
    """
    One question, or the answer already supplied.

    `assume` is what makes the wizard scriptable: every question can be answered
    by a flag, and when they all are nothing is asked and nothing blocks. An
    agent setting a machine up must not be waiting on a prompt nobody will see.
    """
    if assume is not None:
        return assume
    if not sys.stdin.isatty():
        if default is None:
            fail(f"{prompt} — no answer given and nothing to read from; pass the flag instead")
        return default
    suffix = f" [{'/'.join(choices)}]" if choices else (f" [{default}]" if default else "")
    while True:
        answer = input(f"{prompt}{suffix}: ").strip()
        if not answer and default is not None:
            return default
        if choices and answer not in choices:
            print(f"  choose one of: {', '.join(choices)}")
            continue
        if answer:
            return answer


def init_bank(path, remote=None):
    """
    Make a directory into a bank.

    Idempotent: an existing bank is adopted rather than reinitialised, because
    the common second run of `setup` is someone pointing at a clone they already
    have, and re-initialising it would be the one destructive thing this command
    could do.
    """
    path = Path(path).expanduser().resolve()
    existed = is_bank(path)
    (path / "memories").mkdir(parents=True, exist_ok=True)
    (path / "inbox").mkdir(parents=True, exist_ok=True)

    # A fresh bank carries its own copy of the CLI, the way the original bank
    # does: share the repo and whoever clones it has the tool — hooks, gates
    # and all — with no separate install. An adopted bank is left as found; a
    # content-only bank stays content-only unless its owner decides otherwise.
    seeded = []
    if not existed:
        me = Path(__file__).resolve()
        cli = path / "bin" / SHIM_NAME
        if not cli.exists() and me != cli:
            cli.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(me, cli)
            cli.chmod(cli.stat().st_mode | 0o111)
            seeded.append(f"bin/{SHIM_NAME}")
        template = me.parent.parent / "templates" / "memory.md"
        dest = path / "templates" / "memory.md"
        if template.is_file() and not dest.exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(template, dest)
            seeded.append("templates/memory.md")

    if not (path / ".git").is_dir():
        if run_git(path, "init", "--quiet") is None and run_git(path, "rev-parse", "HEAD") is None:
            fail(f"could not git init {path}")
    if remote and not run_git(path, "remote", "get-url", "origin"):
        run_git(path, "remote", "add", "origin", remote)

    # A bank with no commit has no HEAD, and several paths read one. An empty
    # initial commit is cheaper than making each of them tolerate its absence.
    if run_git(path, "rev-parse", "HEAD") is None:
        gitkeep = path / "inbox" / ".gitkeep"
        gitkeep.touch()
        run_git(path, "add", "--", "inbox/.gitkeep", *seeded)
        run_git(path, "commit", "-m", "The bank begins", "--", "inbox/.gitkeep", *seeded)

    # Checked rather than assumed, because the usual reason it fails is a
    # machine with no git identity — and that failure is silent. Left alone it
    # produces a bank that looks finished, holds no HEAD, and breaks the first
    # time anything reads one. Better to say so here, with the fix.
    if run_git(path, "rev-parse", "HEAD") is None:
        identity = run_git(path, "config", "user.email")
        fail(f"created {path} but could not make its first commit"
             + ("" if identity else
                " — git has no identity on this machine.\n"
                "  Set one, then run setup again:\n"
                '    git config --global user.email "you@example.com"\n'
                '    git config --global user.name "Your Name"'))
    return path, existed


def cmd_setup(args):
    """
    Point this machine at a bank, and remember which.

    Two shapes, and the difference is only whether a remote exists. A local bank
    keeps every gate — schema, secret scan, injection lint — and lands a memory
    as a plain commit; a shared one lands it as a pull request that merges
    itself. Nothing else changes, which is why local-only needed a setup command
    rather than a separate mode: the machinery was already there and unreachable.
    """
    mode = args.mode or ask(
        "Bank shared with a team over a remote, or local to this machine only?",
        default="local", choices=["local", "remote"])

    remote = args.remote
    if mode == "remote" and not remote:
        remote = ask("Remote URL", default=CEREBRO_REPO_URL)

    banks = load_banks()
    default_path = str(Path.home() / "Documents" / "cerebro")
    path = Path(args.path or ask("Where should the bank live?", default=default_path)).expanduser()

    # The first bank keeps the legacy slug — its installs already live under it
    # on every pre-multi-bank machine. Later banks are named after their
    # directory unless told otherwise.
    derived = LEGACY_SLUG if not banks else (norm(path.name) or f"bank-{len(banks) + 1}")
    slug = ask("Short name (slug) for this bank", default=derived, assume=args.slug)
    if not SLUG_RE.fullmatch(slug):
        fail(f"{slug!r} is not a kebab-case slug (e.g. client-docs)")
    for bank in banks:
        if bank["slug"] != slug and Path(bank["path"]).expanduser() == path:
            fail(f"{path} is already registered as {bank['slug']!r} — "
                 f"`cerebro forget {bank['slug']}` first to rename it")

    if mode == "remote" and not path.exists() and remote:
        print(f"cerebro: cloning {remote} into {path}")
        path.parent.mkdir(parents=True, exist_ok=True)
        if run_git(path.parent, "clone", "--quiet", remote, str(path), timeout=300) is None:
            # git's own last words, not just ours: "could not clone <url>" is
            # true of a private repo, a typo, an offline laptop and a wrong
            # branch alike, and the difference is the whole of what the reader
            # needs.
            said = last_git_error()
            fail(f"could not clone {remote}: {said}" if said else f"could not clone {remote}")

    path, existed = init_bank(path, remote if mode == "remote" else None)

    entry = {"slug": slug, "path": str(path),
             "role": "readonly" if args.role == "readonly" else "readwrite", "enabled": True}
    banks = [b for b in load_banks() if b["slug"] != slug]
    banks.append(entry)
    make_default = bool(args.make_default) or len(banks) == 1
    written = save_banks(banks, slug if make_default else None)

    print(f"\ncerebro: bank {'adopted' if existed else 'created'} at {path}")
    print(f"cerebro: registered as {slug!r}"
          + (" (default)" if make_default else "")
          + (", read-only on this machine" if entry["role"] == "readonly" else ""))
    print(f"cerebro: {'shared — memories land as auto-merging pull requests' if mode == 'remote' else 'local only — memories land as plain commits, and never leave this machine'}")
    print(f"cerebro: remembered in {written}")

    # The gates are the point of the bank, so a setup that leaves them broken
    # is worse than one that refused. Reported rather than enforced: a machine
    # missing `gh` can still run a local bank perfectly well.
    #
    # `gather_checks` rather than `cmd_doctor`, which exits with a status — from
    # here that would end the wizard before it says what to do next, and turn a
    # warning about an optional tool into a failed setup.
    #
    # The network probe is skipped for a local bank because there is no remote
    # to reach, and a check that fails for a thing you deliberately do not have
    # is noise that teaches people to ignore the output.
    print()
    for check in gather_checks(path, artemis_root(args), network=(mode == "remote")):
        mark = {"ok": "ok  ", "warn": "warn", "fail": "FAIL"}[check["state"]]
        print(f"[{mark}] {check['label']}: {check['detail']}")
        if check["remedy"] and check["state"] != "ok":
            print(f"         → {check['remedy']}")

    print("\nNext: `cerebro pull` installs the bank into your Artemis projects.")


def cmd_forget(args):
    """Drop a bank from the config. The repo and any installed copies stay —
    forgetting is about this machine's routing, not about deleting anything."""
    banks = load_banks()
    keep = [b for b in banks if b["slug"] != args.slug]
    if len(keep) == len(banks):
        known = ", ".join(b["slug"] for b in banks) or "none configured"
        fail(f"no configured bank named {args.slug!r} (known: {known})")
    save_banks(keep)
    print(f"cerebro: forgot {args.slug!r} — the repo stays on disk. "
          f"Run `cerebro --bank <path> uninstall --all-projects` beforehand next time "
          f"if you also wanted its installed copies gone.")


