def _check(cid, label, state, detail, remedy=None):
    return {"id": cid, "label": label, "state": state, "detail": detail, "remedy": remedy}


def _tool_version(binary, *argv):
    """First line of `binary --version`, or None when the tool is absent."""
    if shutil.which(binary) is None:
        return None
    try:
        out = subprocess.run([binary, *argv], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip().splitlines()[0] if out.returncode == 0 and out.stdout.strip() else None


def check_python():
    v = sys.version_info
    return _check("python", "Python 3.8+", "ok",
                  "python %d.%d.%d at %s" % (v[0], v[1], v[2], sys.executable))


def check_git():
    found = shutil.which("git")
    if found is None:
        return _check("git", "git", "fail", "not on PATH",
                      "macOS: xcode-select --install (or brew install git)")
    version = _tool_version("git", "--version")
    if version is None:
        return _check("git", "git", "fail", f"{found} did not answer `git --version`",
                      "Reinstall git, or check that the binary on PATH is really git")
    return _check("git", "git", "ok", version)


def check_git_identity(repo=None):
    """Required to land anything: an unset identity makes `git commit` refuse.

    Asked *of the repository being committed to*, not of $HOME, so that git's
    own precedence applies — a per-repo `user.email` is common (work vs.
    personal) and is a perfectly good identity that a global-only check would
    call missing.
    """
    if shutil.which("git") is None:
        return _check("git-identity", "git identity", "fail", "git is not installed",
                      "Install git first")
    where = repo if repo is not None else Path.home()
    name = run_git(where, "config", "--get", "user.name")
    email = run_git(where, "config", "--get", "user.email")
    if not name or not email:
        return _check("git-identity", "git identity", "fail",
                      "user.name or user.email is unset — commits would be refused",
                      'git config --global user.name "Your Name" && '
                      'git config --global user.email "you@example.com"')
    return _check("git-identity", "git identity", "ok", f"{name} <{email}>")


def check_gh():
    """Optional: without it a promotion pushes the branch and you open the PR."""
    version = _tool_version("gh", "--version")
    if version is None:
        return _check("gh", "GitHub CLI (optional)", "warn",
                      "not on PATH — promotions push a branch and print the link instead of opening a PR",
                      "brew install gh")
    try:
        out = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        return _check("gh", "GitHub CLI (optional)", "warn", f"{version}, auth status unknown", None)
    if out.returncode != 0:
        return _check("gh", "GitHub CLI (optional)", "warn", f"{version}, not signed in",
                      "gh auth login")
    return _check("gh", "GitHub CLI (optional)", "ok", version)


def check_path_shim(repo):
    """Does the bare verb the agent prompt teaches actually resolve?

    A warning, never a failure: everything still works through the full path,
    and the prompt says so. But an agent told to run `cerebro draft` on a
    machine where that is not a command is an agent that writes nothing, and
    that is precisely the failure this check exists to make visible.
    """
    found = shutil.which(SHIM_NAME)
    cli = repo / "bin" / SHIM_NAME if repo is not None else None
    if found is None:
        return _check("shim", "cerebro on PATH", "warn",
                      "not on PATH — agents are told to run `cerebro` and would fall back to the full path",
                      "bin/cerebro enable  (installs the link)")
    if found.lower().endswith(".cmd"):
        # The Windows shim is a launcher rather than a link; it is ours when it
        # says so and current when it names the CLI it should.
        try:
            content = Path(found).read_text(encoding="utf-8-sig", errors="replace")
        except OSError:
            content = ""
        if "cerebro shim" not in content:
            return _check("shim", "cerebro on PATH", "warn",
                          f"{found} is not cerebro's shim",
                          f"Remove {found}, then re-run bin/cerebro enable")
        if cli is not None and str(cli.resolve()) not in content:
            return _check("shim", "cerebro on PATH", "warn",
                          f"{found} launches a different checkout ({cli} expected)",
                          "Re-run bin/cerebro enable to repoint it")
        return _check("shim", "cerebro on PATH", "ok", found)
    if cli is not None and Path(found).resolve() != cli.resolve():
        return _check("shim", "cerebro on PATH", "warn",
                      f"{found} is not this checkout ({cli})",
                      f"Remove {found}, then re-run bin/cerebro enable")
    return _check("shim", "cerebro on PATH", "ok", found)


def remote_label(url):
    """`org/repo` as a person would name it, out of any remote URL form.

    Named rather than quoted whole because the remedy that uses it is a
    sentence, and a URL in the middle of one is unreadable. Any userinfo is
    dropped on the way out: a remote somebody pasted a token into must not have
    it echoed back by a message this CLI prints.
    """
    text = re.sub(r"\.git$", "", (url or "").strip().rstrip("/"))
    if "://" in text:
        text = text.split("://", 1)[1].split("@")[-1]
        parts = text.split("/", 1)
        return parts[1] if len(parts) > 1 and parts[1] else text
    if ":" in text:
        return text.split(":", 1)[1] or text
    return text


def check_remote_access(url):
    """Can this machine actually reach the private bank? The real auth gate."""
    if shutil.which("git") is None:
        return _check("remote", "Bank access", "fail", "git is not installed", "Install git first")
    try:
        out = subprocess.run(["git", "ls-remote", "--exit-code", url, "HEAD"],
                             capture_output=True, text=True, timeout=30,
                             env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
    except subprocess.TimeoutExpired:
        return _check("remote", "Bank access", "warn", f"{url} did not answer within 30s",
                      "Check your network, then retry")
    except OSError as exc:
        return _check("remote", "Bank access", "fail", str(exc), None)
    if out.returncode == 0:
        return _check("remote", "Bank access", "ok", f"{url} reachable")
    said = (out.stderr or "").strip().splitlines()
    # The remedy names the remote that was actually probed. It used to name
    # this project's own upstream whatever it had just checked, which for
    # anyone running their own bank was advice about a repository they have
    # never heard of and cannot be given access to.
    return _check("remote", "Bank access", "fail",
                  said[-1] if said else f"cannot read {url}",
                  f"Sign in to that host (gh auth login, an SSH key, or an access token) and "
                  f"ask for access to {remote_label(url)} — it may be a private repository")


def check_artemis(root):
    if (root / "profiles.json").is_file():
        try:
            n = len(load_profiles(root))
        except SystemExit:
            n = 0
        return _check("artemis", "Artemis profiles", "ok", f"{n} profile(s) under {root}")
    return _check("artemis", "Artemis profiles", "fail", f"no profiles.json under {root}",
                  "Launch Artemis and create a profile first, or pass --root / set ARTEMIS_ROOT")


def check_destination(path):
    """
    Pre-clone: is the destination usable? Post-clone: is it a bank?

    A bank is a directory holding `memories/` (or `projects/` with a projects layout), which is the same test
    `repo_root` applies. It used to be "a directory holding `bin/cerebro`" —
    that is, *this* repo — which was true while the only bank was the shared
    one and became wrong the moment a machine could point somewhere else. A
    local bank has no reason to carry a copy of the CLI.
    """
    if is_bank(path):
        return _check("repo", "Bank checkout", "ok", str(path))
    if path.exists():
        return _check("repo", "Bank checkout", "fail",
                      f"{path} exists but is not a memory bank (no memories/, no projects layout)",
                      "Run `cerebro setup --path <dir>` to make one, or point --bank at an existing bank")
    parent = path.parent
    if not os.access(parent, os.W_OK):
        return _check("repo", "Bank checkout", "fail", f"{parent} is not writable",
                      "Grant access to that folder, or choose another location")
    return _check("repo", "Bank checkout", "warn", f"nothing there yet — will be created at {path}",
                  "cerebro setup")


def gather_checks(repo, root, network=True, destination=None):
    """Every check, for one machine.

    `destination` is where a bank is *going*, which is only the same place as
    `repo` once it exists. Threading it through is what lets `doctor --path
    <dir>` answer for the folder somebody is about to clone into: the check
    used to inspect ~/Documents/cerebro no matter what the caller had chosen,
    and report a stranger's directory as their problem.
    """
    remote = (run_git(repo, "remote", "get-url", "origin") if repo else None) or CEREBRO_REPO_URL
    where = destination or repo or (Path.home() / "Documents" / "cerebro")
    checks = [check_python(), check_git(), check_git_identity(repo), check_gh(),
              check_path_shim(repo),
              check_destination(where),
              check_artemis(root)]
    if network:
        checks.append(check_remote_access(remote))
    return checks


def cmd_doctor(args):
    repo = None
    try:
        repo = repo_root()
    except SystemExit:
        pass
    destination = Path(args.path).expanduser() if getattr(args, "path", None) else None
    checks = gather_checks(repo, artemis_root(args), network=not args.offline,
                           destination=destination)
    ready = not any(c["state"] == "fail" for c in checks)
    if args.json:
        print(json.dumps({"ready": ready, "checks": checks}, indent=2))
        sys.exit(0 if ready else 1)
    marks = {"ok": "ok  ", "warn": "warn", "fail": "FAIL"}
    for c in checks:
        print(f"[{marks[c['state']]}] {c['label']}: {c['detail']}")
        if c["remedy"] and c["state"] != "ok":
            print(f"         → {c['remedy']}")
    print("ready" if ready else "not ready — fix the FAIL lines above")
    sys.exit(0 if ready else 1)


def require_landing_prerequisites(repo):
    """Fail loudly *before* queued drafts are touched, not mid-commit."""
    blocking = [c for c in (check_git(), check_git_identity(repo)) if c["state"] == "fail"]
    if blocking:
        for c in blocking:
            print(f"cerebro: {c['label']}: {c['detail']}", file=sys.stderr)
            if c["remedy"]:
                print(f"cerebro:   → {c['remedy']}", file=sys.stderr)
        return False
    return True


def apply_grouping(repo, metadata, args):
    """File a memory under org/project, from the flags or the bank's defaults.

    An explicit flag that is not a slug is refused — the author can fix it in
    one edit. A *derived* project that is not a slug (a repo directory with a
    dot in it, say) is simply dropped: nobody typed it, so nobody should have
    to answer for it, and the memory files under the org alone."""
    config = load_bank_config(repo)
    nested = bank_layout(repo) == "projects"
    org = getattr(args, "org", None) or config.get("default_org")
    project = getattr(args, "project", None)
    if project is None and not nested:
        project = norm(self_project(repo).name) or None
    if nested:
        # A nested bank has no "unfiled" corner: the folder IS the filing, so
        # the draft must name a project that exists. Guessing from the cwd
        # would mint a project nobody asked for.
        if not org or not project:
            fail("this bank files memories by project — pass --org and --project "
                 "(the projects are listed in INDEX.md)")
        if not (Path(repo) / "projects" / str(org) / str(project)).is_dir():
            fail(f"no project {org}/{project} in this bank — pick one from INDEX.md, or create "
                 f"projects/{org}/{project}/PROJECT.md first")
    if not org:
        return
    if not SLUG_RE.fullmatch(str(org)):
        fail(f"--org {org!r} is not a kebab-case slug")
    metadata["org"] = str(org)
    if project:
        if getattr(args, "project", None) and not SLUG_RE.fullmatch(str(project)):
            fail(f"--project {project!r} is not a kebab-case slug")
        if SLUG_RE.fullmatch(str(project)):
            metadata["project"] = str(project)


def cmd_draft(args):
    repo = repo_root()
    require_writable(repo, "draft")
    if not SLUG_RE.fullmatch(args.name):
        fail(f"{args.name!r} is not a kebab-case slug")
    body = args.body
    if body is None:
        if sys.stdin.isatty():
            fail("provide --body or pipe the body on stdin")
        body = sys.stdin.read()
    metadata = {"type": args.type, "added": datetime.date.today().isoformat()}
    if args.applies_to:
        entries = [e for chunk in args.applies_to for e in re.split(r"[,\s]+", chunk) if e]
        metadata["applies_to"] = ", ".join(entries)
    if args.author:
        metadata["author"] = args.author
    apply_grouping(repo, metadata, args)
    inbox = repo / "inbox"
    inbox.mkdir(exist_ok=True)
    dest = inbox / f"{args.name}.md"
    mem = Memory(dest, args.name, args.description, metadata, body.strip("\n"))
    errors, warnings = check_memory(mem)
    # Warnings block here because CI blocks on them (`validate --strict`). A
    # draft that merely warns would sail through to a pull request that can
    # never merge — and with auto-merge armed, nothing would come along to
    # notice. Better to refuse at the point of authorship, where the agent
    # that wrote the sentence can still fix it.
    #
    # How the refusal reads is load-bearing. The reader is usually an agent
    # mid-task, deciding in one step whether this is a wall or a lint error,
    # and the first version of this said "ERROR" to both kinds and left the
    # rest to inference. Nothing is wrong with the draft that the draft's
    # author cannot fix in one edit, so the message says exactly that.
    if errors or warnings:
        for e in errors:
            print(f"error   {dest.name}: {e}", file=sys.stderr)
        for w in warnings:
            print(f"warning {dest.name}: {w}", file=sys.stderr)
        print("\nNothing was written. Each line above names one thing to change; "
              "CI validates with --strict, so warnings have to go too.\n"
              "Edit the --description/--body and run the same command again — "
              "a refused draft is routine, not a reason to give up on the memory.",
              file=sys.stderr)
        sys.exit(1)
    dest.write_text(render_memory(mem), encoding="utf-8")
    print(f"queued inbox/{dest.name} — lands via `bin/cerebro promote` or the next sync")


def arm_auto_merge(repo, branch):
    """Queue the PR to merge itself once the required checks pass.

    The last human step in the loop that did not need to be one: a memory PR is
    machine-authored, machine-validated (schema, secret scan, injection lint —
    at draft, at promote, and again as the `validate` check on the PR), and
    nobody is better placed than CI to say whether it may land. Branch
    protection still decides *when*: auto-merge waits for the required check,
    so a bank that fails validation stays open rather than merging itself.

    Best-effort. If the repo has auto-merge disabled, or the token cannot use
    it, the PR simply stays open for a human — which is the old behaviour, not
    a failure.
    """
    out = subprocess.run(["gh", "pr", "merge", "--auto", "--squash", "--delete-branch", branch],
                         cwd=repo, capture_output=True, text=True, timeout=60)
    if out.returncode == 0:
        print("cerebro: auto-merge armed — it lands when validate passes")
        return True
    said = (out.stderr or out.stdout or "").strip().splitlines()
    print("cerebro: could not arm auto-merge (the PR stays open for review): "
          + (said[-1] if said else "gh declined"))
    return False


def land_via_pr(repo, msg, branch_slug, mutate, auto_merge=True):
    base = run_git(repo, "symbolic-ref", "--short", "refs/remotes/origin/HEAD") or "origin/main"
    if run_git(repo, "rev-parse", "--verify", base) is None:
        run_git(repo, "fetch", "origin", timeout=60)
        if run_git(repo, "rev-parse", "--verify", base) is None:
            print(f"cerebro: cannot resolve {base}; change not landed")
            return False
    ts = datetime.datetime.now().strftime("%Y%m%d%H%M%S")
    branch = f"memory-{ts}-{branch_slug}"[:60]
    wtbase = Path(tempfile.mkdtemp(prefix="cerebro-wt-"))
    wt = wtbase / "wt"
    try:
        if run_git(repo, "worktree", "add", "--detach", str(wt), base) is None:
            print("cerebro: worktree failed; change not landed")
            return False
        mutate(wt)
        run_git(wt, "add", "-A", "projects" if bank_layout(repo) == "projects" else "memories")
        if run_git(wt, "commit", "-m", msg) is None:
            print("cerebro: commit failed; change not landed")
            return False
        if run_git(wt, "push", "origin", f"HEAD:refs/heads/{branch}", timeout=60) is None:
            print("cerebro: push failed; change not landed")
            return False
        if shutil.which("gh"):
            r = subprocess.run(
                ["gh", "pr", "create", "--head", branch, "--title", msg, "--body",
                 "Automated memory change from an agent session; validated by bin/cerebro."],
                cwd=repo, capture_output=True, text=True, timeout=60)
            if r.returncode == 0:
                print(f"cerebro: opened PR for {branch}")
                if auto_merge:
                    arm_auto_merge(repo, branch)
            else:
                print(f"cerebro: pushed {branch} — open a PR to merge it")
        else:
            print(f"cerebro: pushed {branch} — open a PR to merge it")
        return True
    except (OSError, subprocess.TimeoutExpired):
        print("cerebro: landing failed; change not applied")
        return False
    finally:
        run_git(repo, "worktree", "remove", "--force", str(wt))
        shutil.rmtree(wtbase, ignore_errors=True)


def do_promote(repo, quiet=False, auto_merge=True):
    inbox = repo / "inbox"
    candidates = sorted(inbox.glob("*.md")) if inbox.is_dir() else []
    good = []
    for f in candidates:
        mem, perrors = parse_memory(f)
        problems = check_memory(mem) if mem else ([], [])
        # Same strictness as CI, for the same reason as in `draft` above.
        errors = perrors + problems[0] + problems[1]
        if errors:
            bad = f.with_name(f.name + ".rejected")
            f.rename(bad)
            for e in errors:
                print(f"cerebro: rejected inbox/{bad.name}: {e}")
            continue
        good.append(mem)
    if not good:
        return []
    if not require_landing_prerequisites(repo):
        print("cerebro: candidates stay queued in inbox/ until the above is fixed", file=sys.stderr)
        return []
    names = [m.name for m in good]
    adds = [n for n in names if find_memory_file(repo, n) is None]
    ups = [n for n in names if n not in adds]
    msg = "memory: " + "; ".join((["add " + ", ".join(adds)] if adds else [])
                                 + (["update " + ", ".join(ups)] if ups else []))
    def place(root, m):
        # A slug that moved orgs updates in place: the old file goes, the new
        # location gets the fresh render, and `add -A memories` carries both.
        dest = memory_dest(root, m)
        old = find_memory_file(root, m.name)
        if old is not None and old.resolve() != dest.resolve():
            old.unlink()
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(render_memory(m), encoding="utf-8")

    if run_git(repo, "remote"):
        def write_all(wt):
            for m in good:
                place(wt, m)
        ok = land_via_pr(repo, msg, good[0].name, write_all, auto_merge=auto_merge)
    else:
        for m in good:
            place(repo, m)
        tree = "projects" if bank_layout(repo) == "projects" else "memories"
        run_git(repo, "add", "-A", "--", tree)
        ok = run_git(repo, "commit", "-m", msg, "--", tree) is not None
        if not ok:
            print(f"cerebro: promote commit failed — files staged in {tree}/, resolve manually")
    if ok:
        for m in good:
            (inbox / f"{m.name}.md").unlink(missing_ok=True)
        if not quiet:
            print(f"cerebro: promoted {', '.join(names)}")
    return names if ok else []


def cmd_promote(args):
    repo = repo_root()
    require_writable(repo, "promote")
    if not do_promote(repo, quiet=args.quiet, auto_merge=not args.no_auto_merge) and not args.quiet:
        print("nothing to promote")


def sync_bank(repo, entry, args, anchor_repo):
    state = repo / ".git" if (repo / ".git").is_dir() else repo
    lock = state / "cerebro-sync.lock"
    try:
        lock.mkdir()
    except FileExistsError:
        try:
            if time.time() - lock.stat().st_mtime > 300:
                lock.rmdir()
                lock.mkdir()
            else:
                return
        except OSError:
            return
    try:
        # Self-healing, and quiet about it: machines enabled before the shim
        # existed get it on their next session rather than on the next time
        # someone thinks to re-run `enable`. A no-op once it is in place. Only
        # the anchor bank owns the shim — syncing a second bank must not steal it.
        if repo == anchor_repo:
            install_shim(repo, quiet=True)
        # A read-only bank's inbox is never promoted from this machine: the
        # role says this machine consumes, and a queued draft (however it got
        # there) must not become a push to somebody else's repository.
        promoted = [] if entry["role"] == "readonly" else do_promote(repo, quiet=True)
        fetch_stamp = state / "cerebro-fetch-stamp"
        stale = args.force or not fetch_stamp.exists() \
            or time.time() - fetch_stamp.stat().st_mtime > 900
        if run_git(repo, "remote") and stale:
            run_git(repo, "pull", "--ff-only", "--quiet", timeout=60)
            fetch_stamp.write_text("", encoding="utf-8")
        head = run_git(repo, "rev-parse", "HEAD") or "none"
        last_file = state / "cerebro-last-pull"
        last = last_file.read_text(encoding="utf-8").strip() if last_file.is_file() else ""
        root = artemis_root(args)
        slug = entry["slug"]
        if promoted or head != last or args.force:
            pull_bank(repo, argparse.Namespace(profile=[], project=[], all_projects=True,
                                               self_=False, exclude=None, root=args.root,
                                               dry_run=False, quiet=True))
            stamp = source_stamp(repo)
            active = [b for b in load_banks() if b["enabled"]] or [entry]
            for profile in load_profiles(root):
                cfile = profile["dir"] / "CLAUDE.md"
                if cfile.is_file() and begin_marker(slug) in cfile.read_text(encoding="utf-8"):
                    do_enable(profile, repo, stamp, entry, active, anchor_repo)
            last_file.write_text(head, encoding="utf-8")
        else:
            key = project_key(self_project(repo))
            if not any((p["dir"] / "projects" / key / "memory" / bank_subdir(slug)).is_dir()
                       for p in load_profiles(root)):
                pull_bank(repo, argparse.Namespace(profile=[], project=[str(self_project(repo))],
                                                   all_projects=False, self_=False, exclude=None,
                                                   root=args.root, dry_run=False, quiet=True))
    finally:
        try:
            lock.rmdir()
        except OSError:
            pass


def cmd_sync(args):
    """One invocation turns every enabled bank — which is what lets a single
    SessionStart hook, anchored on one CLI, keep all of them fresh."""
    active = [b for b in addressed_banks() if b["enabled"]]
    if not active:
        return
    anchor = default_bank(active) or active[0]
    anchor_repo = Path(anchor["path"]).expanduser().resolve()
    for entry in active:
        repo = Path(entry["path"]).expanduser()
        if not is_bank(repo):
            if not args.quiet:
                print(f"warn  {entry['slug']}: {repo} is not a memory bank — skipped", file=sys.stderr)
            continue
        sync_bank(repo.resolve(), entry, args, anchor_repo)


def main():
    ap = argparse.ArgumentParser(prog="cerebro",
                                 description="Shared team memory bank for the Artemis agent harness")
    ap.add_argument("--version", action="version", version=f"cerebro {VERSION}")
    ap.add_argument("--bank", help="work on this bank for one invocation, ignoring the configured one")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("validate", help="validate memories (schema, secrets, injection)")
    p.add_argument("paths", nargs="*", help="specific files (default: every memory in the bank)")
    p.add_argument("--strict", action="store_true", help="treat warnings as errors")
    p.set_defaults(fn=cmd_validate)

    p = sub.add_parser("new", help="scaffold a new memory in memories/")
    p.add_argument("name", help="kebab-case slug, becomes the filename")
    p.add_argument("--type", required=True, choices=MEMORY_TYPES)
    p.add_argument("--description", help="one line: when is this memory relevant?")
    p.add_argument("--author", help="email to record in metadata")
    p.add_argument("--applies-to", action="append", default=[],
                   help="repo directory name whose projects index this memory "
                        "(repeatable; default: indexed everywhere)")
    p.add_argument("--org", help="organization to file this memory under "
                                 "(default: the bank's default_org)")
    p.add_argument("--project", help="project/topic within the org "
                                     "(default: the current repo's name)")
    p.set_defaults(fn=cmd_new)

    def sync_flags(p):
        p.add_argument("--profile", action="append", default=[],
                       help="profile label or dir name (repeatable; default: all)")
        p.add_argument("--project", action="append", default=[],
                       help="project path (repeatable; default: current repo/cwd)")
        p.add_argument("--all-projects", action="store_true",
                       help="every existing project dir (worktrees/tmp skipped)")
        p.add_argument("--self", dest="self_", action="store_true",
                       help="current project only (the default)")
        p.add_argument("--exclude", help="regex of project keys to skip with --all-projects")
        p.add_argument("--root", help="Artemis root (default: app support dir or $ARTEMIS_ROOT)")

    p = sub.add_parser("pull", help="validate then sync the bank into Artemis project memory")
    sync_flags(p)
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(fn=cmd_pull)

    p = sub.add_parser("uninstall", help="remove synced memories + managed MEMORY.md blocks")
    sync_flags(p)
    p.set_defaults(fn=cmd_uninstall)

    p = sub.add_parser("enable", help="add the bank pointer to profile CLAUDE.md + /cerebro command")
    p.add_argument("--profile", action="append", default=[])
    p.add_argument("--root")
    p.set_defaults(fn=cmd_enable)

    p = sub.add_parser("disable", help="remove the profile CLAUDE.md block + /cerebro command")
    p.add_argument("--profile", action="append", default=[])
    p.add_argument("--root")
    p.set_defaults(fn=cmd_disable)

    p = sub.add_parser("draft", help="queue a memory candidate in inbox/ (agents' write path)")
    p.add_argument("name", help="kebab-case slug; re-use an existing slug to update it")
    p.add_argument("--type", required=True, choices=MEMORY_TYPES)
    p.add_argument("--description", required=True, help="one line: when is this relevant?")
    p.add_argument("--body", help="memory body (or pipe it on stdin)")
    p.add_argument("--author", help="email to record in metadata")
    p.add_argument("--applies-to", action="append", default=[],
                   help="repo directory name whose projects index this memory "
                        "(repeatable; default: indexed everywhere)")
    p.add_argument("--org", help="organization to file this memory under "
                                 "(default: the bank's default_org)")
    p.add_argument("--project", help="project/topic within the org "
                                     "(default: the current repo's name)")
    p.set_defaults(fn=cmd_draft)

    p = sub.add_parser("promote", help="validate queued drafts, then commit (no remote) or open an auto-merging PR")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--no-auto-merge", action="store_true",
                   help="open the PR but leave it for a human to merge")
    p.set_defaults(fn=cmd_promote)

    p = sub.add_parser("sync", help="autonomous cycle: promote drafts, fetch, re-install everywhere (hook entrypoint)")
    p.add_argument("--root")
    p.add_argument("--quiet", action="store_true")
    p.add_argument("--force", action="store_true",
                   help="ignore the fetch throttle and re-install even if unchanged")
    p.set_defaults(fn=cmd_sync)

    p = sub.add_parser("doctor", help="check this machine can run the memory-bank CLI (tools, identity, access)")
    p.add_argument("--root")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--offline", action="store_true", help="skip the remote-access probe")
    p.add_argument("--path", help="check this destination rather than the registered bank's "
                                  "(for asking about a folder before cloning into it)")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("status", help="show bank health and where the CLI is installed")
    p.add_argument("--root")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_status)

    p = sub.add_parser("list", help="list the bank's memories (own + mirror trees)")
    p.add_argument("--json", action="store_true", help="full contents as JSON (for tooling/UI)")
    p.add_argument("--bank-only", action="store_true",
                   help="only the bank's own memories, no read-only mirror trees")
    p.set_defaults(fn=cmd_list)

    p = sub.add_parser("setup", help="register a bank for this machine — shared or local only")
    p.add_argument("--mode", choices=["local", "remote"], help="skip the question")
    p.add_argument("--remote", help="remote URL (implies --mode remote)")
    p.add_argument("--path", help="where the bank lives")
    p.add_argument("--slug", help="short name for this bank; namespaces its installs "
                                  "(default: 'cerebro' for the first bank, else the directory name)")
    p.add_argument("--role", choices=["readwrite", "readonly"], default="readwrite",
                   help="readonly = consume this bank, never draft/promote/retire into it")
    p.add_argument("--make-default", action="store_true",
                   help="bare commands address this bank from now on")
    p.add_argument("--root", help="Artemis root, for the checks run afterwards")
    p.set_defaults(fn=cmd_setup)

    p = sub.add_parser("forget", help="drop a bank from this machine's config (repo stays on disk)")
    p.add_argument("slug", help="configured bank name — see `cerebro banks`")
    p.set_defaults(fn=cmd_forget)

    p = sub.add_parser("banks", help="list the banks this machine is configured with")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.set_defaults(fn=cmd_banks)

    p = sub.add_parser("retire", help="remove a memory through the same gates (commit or PR)")
    p.add_argument("name", help="slug of the memory to retire")
    p.add_argument("--reason", help="short reason recorded in the commit message")
    p.add_argument("--no-auto-merge", action="store_true",
                   help="open the PR but leave it for a human to merge")
    p.set_defaults(fn=cmd_retire)

    args = ap.parse_args()
    # Put it where `repo_root` looks rather than threading it through every
    # command, which would mean touching each one to support a flag none of
    # them cares about.
    if args.bank:
        os.environ["CEREBRO_BANK"] = args.bank
    args.fn(args)


if __name__ == "__main__":
    main()
