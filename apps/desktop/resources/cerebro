def cmd_retire(args):
    repo = repo_root()
    require_writable(repo, "retire")
    existing = find_memory_file(repo, args.name)
    if existing is None:
        fail(f"no memory named {args.name!r} in the bank")
    if not require_landing_prerequisites(repo):
        sys.exit(1)
    msg = f"memory: retire {args.name}" + (f" ({args.reason})" if args.reason else "")
    if run_git(repo, "remote"):
        def drop(wt):
            target = find_memory_file(wt, args.name)
            if target is not None and target.is_file():
                target.unlink()
        if not land_via_pr(repo, msg, f"retire-{args.name}", drop,
                           auto_merge=not args.no_auto_merge):
            sys.exit(1)
    else:
        path = existing.relative_to(repo).as_posix()
        run_git(repo, "rm", "-q", "--", path)
        if run_git(repo, "commit", "-m", msg, "--", path) is None:
            fail("retire commit failed")
        print(f"cerebro: retired {args.name}")


