#!/usr/bin/env python3
"""Team memory bank CLI for the Artemis agent harness.

The repo is the source of truth: one memory per markdown file under memories/
(or, in the `projects` layout, under projects/<org>/<project>/memories/ beside
that project's plans and decisions), reviewed via git. This CLI validates memories and syncs them one-way into
Artemis profile memory directories inside clearly marked, reversible blocks.

Stdlib only. See README.md for the full design.
"""

import sys

import argparse
import datetime
import json
import os
import re
import shutil
import subprocess
import tempfile
import time
from pathlib import Path

VERSION = "0.8.0"

# Path.unlink(missing_ok=...) is the newest thing used here. Checked at runtime
# rather than assumed: the failure without this is a TypeError deep in promote,
# which reads as a cerebro bug rather than as "this Python is too old".
MIN_PYTHON = (3, 8)
if sys.version_info < MIN_PYTHON:  # noqa: E402 — must run before anything else
    sys.stderr.write(
        "cerebro: needs Python %d.%d or newer (running %d.%d).\n"
        "Install a newer python3 (macOS: xcode-select --install, or brew install python).\n"
        % (MIN_PYTHON[0], MIN_PYTHON[1], sys.version_info[0], sys.version_info[1])
    )
    raise SystemExit(1)

CEREBRO_REPO_URL = "https://github.com/Rx-Ventures/cerebro.git"

BEGIN = "<!-- cerebro:begin -->"
END = "<!-- cerebro:end -->"
CMD_MARKER = "<!-- cerebro:managed -->"

# The slug of the bank cerebro managed before it could manage several. It keeps
# the unprefixed markers above and the bare `memory/cerebro/` install dir, so a
# machine that predates multi-bank — every team machine — migrates by meaning
# nothing new. Any other slug gets namespaced markers and `memory/banks/<slug>/`.
LEGACY_SLUG = "cerebro"


def begin_marker(slug):
    return BEGIN if slug == LEGACY_SLUG else f"<!-- cerebro:{slug}:begin -->"


def end_marker(slug):
    return END if slug == LEGACY_SLUG else f"<!-- cerebro:{slug}:end -->"


def bank_subdir(slug):
    """Where a bank's mirror lives inside a project's memory/ directory.

    New banks nest under `banks/` rather than sitting flat because the memory
    directory is the user's: a flat `<slug>/` would make every future slug a
    name their own layout can never use, and pull prunes inside its directory —
    colliding with a personal folder would mean deleting files we never wrote.
    One reserved name (`banks`) instead of an open-ended set.
    """
    return Path("cerebro") if slug == LEGACY_SLUG else Path("banks") / slug

MEMORY_TYPES = ("user", "feedback", "project", "reference")
SLUG_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
MAX_NAME = 60
MAX_DESCRIPTION = 160
MAX_BODY = 6000

SECRET_PATTERNS = [
    ("AWS access key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("private key block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("GitHub token", re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{20,}\b|\bgithub_pat_[A-Za-z0-9_]{20,}\b")),
    ("Slack token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b")),
    ("Anthropic key", re.compile(r"\bsk-ant-[A-Za-z0-9_-]{20,}\b")),
    ("API key literal", re.compile(r"\bsk-[A-Za-z0-9]{20,}\b")),
    ("Google API key", re.compile(r"\bAIza[0-9A-Za-z_-]{30,}\b")),
    ("credential assignment", re.compile(
        r"(?i)\b(api[_-]?key|secret|token|password|passwd|credential)s?\b[\"']?\s*[:=]\s*[\"']?[A-Za-z0-9_\-/+.]{16,}")),
]

INJECTION_PATTERNS = [
    re.compile(r"(?i)ignore\s+(?:all\s+)?(?:previous|prior|above|earlier)\s+instructions"),
    re.compile(r"(?i)disregard\s+(?:all\s+|your\s+)?(?:previous|prior|system|safety)"),
    re.compile(r"(?i)new\s+system\s+prompt"),
    re.compile(r"(?i)do\s+not\s+tell\s+the\s+user"),
    re.compile(r"(?i)hide\s+this\s+from\s+the\s+user"),
    re.compile(r"(?i)override\s+(?:all\s+)?safety"),
]

SHELL_RISK = re.compile(r"(curl[^\n]*\|\s*(?:ba)?sh)|(\brm\s+-rf\b)|(\bsudo\b)")
# "as soon as" is idiom, not a date — the bare word is what ages badly.
RELATIVE_DATES = re.compile(
    r"(?i)\b(yesterday|tomorrow|last (?:week|month|year)|next (?:week|month|year)"
    r"|recently|(?<!as )soon(?! as))\b")

SKIP_PROJECT_KEY = re.compile(r"-claude-worktrees-|--worktrees-")

# One scope entry: a repo directory name, as typed by a person.
APPLIES_TO_ENTRY = re.compile(r"^[A-Za-z0-9_.-]+$")


def fail(msg):
    print(f"cerebro: error: {msg}", file=sys.stderr)
    sys.exit(1)


def config_path():
    """
    Where a chosen bank is remembered.

    XDG rather than the Artemis root, because cerebro is a CLI in its own right
    and a bank is a property of the machine rather than of one agent harness.
    """
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "cerebro" / "config.json"


def load_config():
    """The stored config, or an empty one. Never raises: a corrupt file is not
    a reason to make every command fail, and `setup` will overwrite it."""
    try:
        # utf-8-sig: a BOM is not ours to choke on. This file is cerebro's own,
        # but profiles.json taught the lesson — PowerShell's `Set-Content
        # -Encoding utf8` writes one, and json.loads refuses it.
        return json.loads(config_path().read_text(encoding="utf-8-sig"))
    except (OSError, ValueError):
        return {}


def save_config(config):
    path = config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
    return path


BANK_CONFIG_NAME = "cerebro.json"
BANK_LAYOUTS = ("flat", "projects")


def bank_layout(path):
    """How the bank arranges its files.

    `flat` (the default, and what every bank was before 0.8.0) keeps every
    memory under memories/. `projects` nests memories inside the project they
    belong to — projects/<org>/<project>/memories/<name>.md — beside that
    project's PROJECT.md, plans and decisions, so one folder answers "where do
    I look" for a project. Declared by `layout` in cerebro.json; anything
    unrecognised reads as flat, so an old bank never changes shape under a
    newer CLI and a newer bank fails closed under an older one."""
    try:
        raw = json.loads((Path(path) / BANK_CONFIG_NAME).read_text(encoding="utf-8-sig"))
        layout = raw.get("layout") if isinstance(raw, dict) else None
    except (OSError, ValueError):
        layout = None
    return layout if layout in BANK_LAYOUTS else "flat"


def is_bank(path):
    """A directory is a bank when it holds `memories/`, or declares the
    projects layout and holds `projects/`. The same test `repo_root` has
    always applied, named so `setup` can ask it too."""
    if path is None:
        return False
    path = Path(path)
    if (path / "memories").is_dir():
        return True
    return bank_layout(path) == "projects" and (path / "projects").is_dir()


def memory_files(repo):
    """Every memory file the bank owns, in path order.

    A flat bank reads memories/ recursively (memories/<org>/<project>/ has
    always been allowed there). A projects bank reads only each project's
    memories/ folder, so a note, a plan or a decision record sitting beside
    it is never mistaken for a memory."""
    repo = Path(repo)
    if bank_layout(repo) == "projects":
        return sorted(repo.glob("projects/*/*/memories/**/*.md"))
    return sorted((repo / "memories").rglob("*.md"))


def layout_hint(repo):
    """Where memories land, in words — for prompts and error messages."""
    if bank_layout(repo) == "projects":
        return "projects/<org>/<project>/memories/"
    return "memories/<org>/<project>/"


def load_bank_config(repo):
    """The bank's own layout config — `cerebro.json` at the bank root, or {}.

    Optional by design: a bank without one is the classic flat bank, and every
    behaviour below degrades to exactly what 0.6.0 did. Tolerant like
    load_config — a corrupt file must not take every command down.

    Keys understood:
      default_org   org assumed when a draft names none (and for mirror
                    projects the `orgs` map does not place)
      orgs          {project: org} — places a mirror tree's projects
      trees         [{path, exclude?}] — read-only memory trees the bank
                    carries but does not own (a sync mirror, for instance)
    """
    try:
        raw = json.loads((Path(repo) / BANK_CONFIG_NAME).read_text(encoding="utf-8-sig"))
        return raw if isinstance(raw, dict) else {}
    except (OSError, ValueError):
        return {}


def org_of(config, project):
    """The org a project belongs to: the explicit map first, then the default."""
    orgs = config.get("orgs")
    mapped = orgs.get(project) if isinstance(orgs, dict) and project else None
    if isinstance(mapped, str) and mapped:
        return mapped
    default = config.get("default_org")
    return default if isinstance(default, str) and default else None


def load_banks():
    """
    The configured banks, in config order. `[]` on an unconfigured machine.

    Two stored shapes. `banks` is the current one — a list of entries, each a
    slug (the per-machine name that namespaces its installs), a path, a role
    (`readwrite`, or `readonly` for a bank this machine consumes but must never
    write to), and an enabled flag. The pre-multi-bank shape was a single
    `bank` path; it reads as one enabled read-write bank under {@link
    LEGACY_SLUG}, which is exactly where a single-bank machine's installs
    already live — the migration is a change of description, not of disk.
    """
    cfg = load_config()
    raw = cfg.get("banks")
    if raw is None:
        legacy = cfg.get("bank")
        if not legacy:
            return []
        return [{"slug": LEGACY_SLUG, "path": str(legacy), "role": "readwrite", "enabled": True}]
    banks = []
    for entry in raw if isinstance(raw, list) else []:
        if not isinstance(entry, dict):
            continue
        slug, path = entry.get("slug"), entry.get("path")
        if not slug or not path or not SLUG_RE.fullmatch(str(slug)):
            continue
        banks.append({
            "slug": str(slug),
            "path": str(path),
            "role": "readonly" if entry.get("role") == "readonly" else "readwrite",
            "enabled": entry.get("enabled") is not False,
        })
    return banks


def save_banks(banks, default_slug=None):
    """Write the bank list, keeping the legacy `bank` key as a mirror of the
    default entry — an older CLI (an embedded copy in some other clone) reads
    only that key, and it should keep resolving to something sensible."""
    cfg = load_config()
    cfg["banks"] = banks
    slugs = [b["slug"] for b in banks]
    if default_slug in slugs:
        cfg["default"] = default_slug
    elif cfg.get("default") not in slugs:
        cfg.pop("default", None)
    mirror = next((b for b in banks if b["slug"] == cfg.get("default")), banks[0] if banks else None)
    if mirror is not None:
        cfg["bank"] = mirror["path"]
    else:
        cfg.pop("bank", None)
    return save_config(cfg)


def default_bank(banks):
    """The bank a bare command addresses: the configured default, else the first."""
    want = load_config().get("default")
    for bank in banks:
        if bank["slug"] == want:
            return bank
    return banks[0] if banks else None


def bank_entry_for(repo):
    """
    The config entry describing this repo, or a synthetic legacy one.

    The synthetic fallback is what keeps an unconfigured machine — and a bank
    addressed by bare path — behaving exactly as before multi-bank existed:
    legacy namespace, read-write, enabled. Namespacing is a property of being
    *configured* under a slug, never inferred from a directory name, because a
    rename silently changing where memories install is the kind of surprise a
    memory system exists to prevent.
    """
    resolved = Path(repo).resolve()
    for bank in load_banks():
        try:
            if Path(bank["path"]).expanduser().resolve() == resolved:
                return bank
        except OSError:
            continue
    return {"slug": LEGACY_SLUG, "path": str(resolved), "role": "readwrite", "enabled": True}


def require_writable(repo, verb):
    """The role gate: a read-only bank takes no drafts, promotions, or retirements."""
    entry = bank_entry_for(repo)
    if entry["role"] == "readonly":
        fail(f"bank {entry['slug']!r} ({repo}) is read-only on this machine — "
             f"{verb} writes to the bank; consume it, or re-run "
             f"`cerebro setup --slug {entry['slug']} --role readwrite` if that changed")


def addressed_banks():
    """
    Every bank a machine-wide command (enable, disable, sync) should cover.

    `--bank`/$CEREBRO_BANK narrows to the one it names — the flag has always
    meant "this invocation, this bank". Otherwise every configured bank; on an
    unconfigured machine, the repo the script ships in, which is the exact
    single-bank behaviour these commands had before banks were plural.
    """
    if os.environ.get("CEREBRO_BANK"):
        return [bank_entry_for(repo_root())]
    banks = load_banks()
    if banks:
        return banks
    return [bank_entry_for(repo_root())]


def repo_root():
    """
    The bank this invocation works on.

    Four sources, most explicit first. The last is what cerebro has always done
    — the bank containing this script — so a machine that has never run `setup`
    behaves exactly as before. Choosing a different bank is opt-in, which is the
    whole point: the shared bank is the default and a private one is a decision.

      1. `--bank`, which `main` puts in the environment so nothing has to thread
         it through every command. A configured slug, or a path.
      2. `$CEREBRO_BANK`, for a shell or a CI job that wants one invocation
         pointed elsewhere
      3. the default among the banks recorded by `cerebro setup`
      4. the repo this script lives in
    """
    ref = os.environ.get("CEREBRO_BANK")
    if ref:
        for bank in load_banks():
            if bank["slug"] == ref:
                path = Path(bank["path"]).expanduser()
                if not is_bank(path):
                    fail(f"configured bank {ref!r} points at {path}, which is not a memory bank "
                         f"(no memories/, and no projects/ with a projects layout)")
                return path.resolve()
        path = Path(ref).expanduser()
        if not is_bank(path):
            fail(f"$CEREBRO_BANK points at {path}, which is not a memory bank")
        return path.resolve()

    chosen = default_bank(load_banks())
    if chosen is not None:
        path = Path(chosen["path"]).expanduser()
        if not is_bank(path):
            fail(f"{config_path()} points at {path}, which is not a memory bank "
                 "(run `cerebro setup` to change it)")
        return path.resolve()

    here = Path(__file__).resolve().parent.parent
    if not is_bank(here):
        fail(f"cannot locate repo root ({here} is not a memory bank) — run `cerebro setup`")
    return here


# The stderr of the most recent run_git call.
#
# run_git's contract is "the output, or None" — which throws away the only part
# of a git failure anybody can act on. A clone that dies of a 403, of a name
# that will not resolve, or of a branch that is not there reaches the caller as
# the same None, and every one of them used to reach the user as the same four
# words. Kept here so the two callers that have something to say can say it.
#
# A module global rather than a second return value: run_git is called from a
# couple of dozen places that want the string, and widening all of them to
# carry an error they ignore is a worse trade than one variable read
# immediately after the call that set it.
_LAST_GIT_STDERR = ""


def last_git_error(lines=2):
    """The tail of the last git failure's stderr, or "" if it said nothing."""
    said = [line.strip() for line in _LAST_GIT_STDERR.splitlines() if line.strip()]
    return " · ".join(said[-lines:])


def run_git(repo, *argv, timeout=10):
    global _LAST_GIT_STDERR
    _LAST_GIT_STDERR = ""
    try:
        out = subprocess.run(["git", "-C", str(repo), *argv],
                             capture_output=True, text=True, timeout=timeout)
        if out.returncode == 0:
            return out.stdout.strip()
        _LAST_GIT_STDERR = out.stderr or ""
        return None
    except subprocess.TimeoutExpired:
        _LAST_GIT_STDERR = "git did not answer within %ss" % timeout
        return None
    except OSError as exc:
        _LAST_GIT_STDERR = str(exc)
        return None


def source_stamp(repo):
    sha = run_git(repo, "rev-parse", "--short", "HEAD") or "uncommitted"
    dirty = run_git(repo, "status", "--porcelain")
    if dirty:
        sha += "+dirty"
    return f"cerebro@{sha}"


# ---------------------------------------------------------------- memory files

class Memory:
    def __init__(self, path, name, description, metadata, body):
        self.path = path
        self.name = name
        self.description = description
        self.metadata = metadata
        self.body = body
        # Grouping, filled by the loaders: where this memory sits in the
        # org -> project hierarchy, which tree it came from, and whether that
        # tree is one this CLI may write to.
        self.org = None
        self.project = None
        self.tree = None
        self.readonly = False


def _unquote(value):
    if len(value) >= 2 and value[0] == value[-1] == '"':
        return value[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    return value


def _quote(value):
    if any(tok in value for tok in (": ", " #", '"')) or value[:1] in "\"'{[&*!|>%@`":
        return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'
    return value


def parse_memory(path):
    errors = []
    try:
        raw = path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return None, ["file not found"]
    except UnicodeDecodeError:
        return None, ["file is not valid UTF-8"]
    if "\r" in raw:
        return None, ["file contains CR line endings; use LF"]
    if not raw.startswith("---\n"):
        return None, ["missing frontmatter (file must start with ---)"]
    try:
        head, body = raw[4:].split("\n---\n", 1)
    except ValueError:
        return None, ["unterminated frontmatter (no closing ---)"]

    fields, metadata = {}, {}
    in_meta = False
    for ln in head.splitlines():
        if not ln.strip():
            continue
        if ln == "metadata:":
            in_meta = True
            continue
        if ln.startswith("  ") and in_meta:
            key, sep, value = ln.strip().partition(": ")
            if not sep:
                errors.append(f"bad metadata line: {ln.strip()!r}")
                continue
            metadata[key] = _unquote(value.strip())
        elif not ln.startswith(" "):
            in_meta = False
            key, sep, value = ln.partition(": ")
            if not sep or not value.strip():
                errors.append(f"bad frontmatter line: {ln!r}")
                continue
            if key not in ("name", "description"):
                errors.append(f"unknown frontmatter key: {key!r}")
                continue
            fields[key] = _unquote(value.strip())
        else:
            errors.append(f"unexpected indentation: {ln!r}")

    mem = Memory(path, fields.get("name", ""), fields.get("description", ""),
                 metadata, body.strip("\n"))
    return mem, errors


def check_memory(mem):
    errors, warnings = [], []
    if not mem.name:
        errors.append("missing name")
    elif not SLUG_RE.fullmatch(mem.name):
        errors.append(f"name {mem.name!r} is not a kebab-case slug")
    elif len(mem.name) > MAX_NAME:
        errors.append(f"name longer than {MAX_NAME} chars")
    if mem.name and mem.path.stem != mem.name:
        errors.append(f"filename {mem.path.name!r} does not match name {mem.name!r}")
    if not mem.description:
        errors.append("missing description")
    elif len(mem.description) > MAX_DESCRIPTION:
        errors.append(f"description longer than {MAX_DESCRIPTION} chars")
    mtype = mem.metadata.get("type", "")
    if mtype not in MEMORY_TYPES:
        errors.append(f"metadata.type must be one of {', '.join(MEMORY_TYPES)} (got {mtype!r})")
    if not mem.body:
        errors.append("empty body")
    elif len(mem.body) > MAX_BODY:
        errors.append(f"body longer than {MAX_BODY} chars — split into atomic memories")

    searchable = mem.description + "\n" + mem.body
    for label, pat in SECRET_PATTERNS:
        if pat.search(searchable):
            errors.append(f"possible secret ({label}) — memories must never contain credentials")
    for pat in INJECTION_PATTERNS:
        if pat.search(searchable):
            errors.append(f"instruction-injection phrase matching {pat.pattern!r}")

    raw_scope = mem.metadata.get("applies_to")
    if raw_scope is not None:
        entries = [e for e in re.split(r"[,\s]+", raw_scope.strip()) if e]
        if not entries:
            errors.append("applies_to is present but names no repos — remove the key to mean everywhere")
        for entry in entries:
            if not APPLIES_TO_ENTRY.fullmatch(entry):
                errors.append(f"applies_to entry {entry!r} is not a repo directory name")

    if mtype in ("feedback", "project"):
        if "**Why:**" not in mem.body or "**How to apply:**" not in mem.body:
            warnings.append("feedback/project memories should include **Why:** and **How to apply:** lines")
    m = SHELL_RISK.search(searchable)
    if m:
        warnings.append(f"embedded shell command ({m.group(0)!r}) — reviewers should confirm it belongs here")
    m = RELATIVE_DATES.search(searchable)
    if m:
        warnings.append(f"relative date {m.group(0)!r} — use absolute dates so the memory ages well")
    return errors, warnings


def classify_bank_path(repo, path):
    """(org, project) from a memory's position.

    Projects layout: projects/<org>/<project>/memories/... — the two folder
    names are the answer, and a file anywhere else is nobody's. Flat layout:
    position under memories/ — flat files are the classic unfiled bank, one
    directory deep is an org with no project; two or more is org/project,
    with deeper levels folding into the project name so a stray extra
    directory cannot hide a memory."""
    repo = Path(repo)
    if bank_layout(repo) == "projects":
        try:
            parts = Path(path).resolve().relative_to((repo / "projects").resolve()).parts
        except (OSError, ValueError):
            return None, None
        if len(parts) >= 4 and parts[2] == "memories":
            return parts[0], parts[1]
        return None, None
    try:
        parts = Path(path).resolve().relative_to((repo / "memories").resolve()).parts[:-1]
    except (OSError, ValueError):
        return None, None
    if not parts:
        return None, None
    if len(parts) == 1:
        return parts[0], None
    return parts[0], "/".join(parts[1:])


def load_bank(repo, paths=None):
    # rglob, not glob: the bank's own tree may nest memories/<org>/<project>/.
    # Names stay globally unique across the whole tree — installs flatten to
    # <name>.md, so two orgs sharing a slug would silently overwrite each other.
    files = sorted(paths or memory_files(repo))
    nested = bank_layout(repo) == "projects"
    results, seen = [], {}
    for f in files:
        mem, perrors = parse_memory(Path(f))
        errors, warnings = ([], []) if mem is None else check_memory(mem)
        errors = perrors + errors
        if mem is not None:
            mem.org, mem.project = classify_bank_path(repo, f)
            mem.tree = "memories"
            if nested:
                # The folder is the truth; a frontmatter that disagrees is a
                # file that was moved without being re-filed, or vice versa.
                for key, have in (("org", mem.org), ("project", mem.project)):
                    said = mem.metadata.get(key)
                    if said and have and str(said) != have:
                        errors.append(f"frontmatter {key}: {said!r} but the file sits under "
                                      f"{have!r} — move the file or fix the key")
        if mem and mem.name:
            if mem.name in seen:
                errors.append(f"duplicate name {mem.name!r} (also in {seen[mem.name].name})")
            else:
                seen[mem.name] = Path(f)
        results.append((Path(f), mem, errors, warnings))
    return results


def load_mirror_trees(repo):
    """Memories from the bank's declared read-only trees — see cerebro.json.

    A bank may carry trees it does not own: cortex mirrors per-project session
    memories into memory/<project>/, maintained by its own sync. They surface
    through `list` and `status` so a pane or an agent can consult them, but
    they are never gates, never installed by `pull`, and never written —
    externally owned content is background reference, not bank inventory.

    Lenient on purpose. A file that does not parse is skipped and a name that
    is not a slug is kept: none of it is this CLI's to fix, and refusing to
    show it would just re-create the empty pane this exists to cure. The
    filename stands in when the frontmatter names nothing."""
    repo = Path(repo)
    config = load_bank_config(repo)
    trees = config.get("trees")
    out = []
    for tree in trees if isinstance(trees, list) else []:
        if not isinstance(tree, dict):
            continue
        root = tree.get("path")
        if not isinstance(root, str) or not root or ".." in root or root in ("memories", "projects"):
            continue
        base = repo / root
        if not base.is_dir():
            continue
        exclude = {"index.md", "memory.md", "readme.md"}
        exclude |= {str(e).lower() for e in tree.get("exclude", []) if isinstance(e, str)}
        for f in sorted(base.rglob("*.md")):
            if f.name.lower() in exclude:
                continue
            mem, _ = parse_memory(f)
            if mem is None:
                continue
            if not mem.name:
                mem.name = f.stem
            rel = f.relative_to(base)
            mem.project = rel.parts[0] if len(rel.parts) > 1 else None
            mem.org = org_of(config, mem.project)
            mem.tree = root
            mem.readonly = True
            _, warnings = check_memory(mem)
            out.append((f, mem, [], warnings))
    return out


def find_memory_file(root, name):
    """The existing file for a slug anywhere in the bank, or None. Names are
    globally unique (load_bank enforces it), so the first hit is the one."""
    hits = [f for f in memory_files(root) if f.stem == name]
    return hits[0] if hits else None


def memory_dest(root, mem):
    """Where a memory lands.

    Projects layout: projects/<org>/<project>/memories/<name>.md, and both
    parts are required — a memory that names no project has no home there.
    Flat layout: memories/<org>/<project>/ when its metadata files it, else
    the flat classic path. Only slug-shaped parts make a directory —
    anything else quietly stays flat rather than writing a strange path."""
    org = mem.metadata.get("org")
    project = mem.metadata.get("project")
    if bank_layout(root) == "projects":
        if not (org and project and SLUG_RE.fullmatch(str(org)) and SLUG_RE.fullmatch(str(project))):
            fail(f"{mem.name}: this bank files memories by project — pass --org and --project "
                 f"(the projects are listed in INDEX.md)")
        return Path(root).joinpath("projects", str(org), str(project), "memories", f"{mem.name}.md")
    parts = [str(p) for p in (org, project) if p and SLUG_RE.fullmatch(str(p))]
    return Path(root).joinpath("memories", *parts, f"{mem.name}.md")


def render_memory(mem, extra_metadata=None):
    lines = ["---", f"name: {mem.name}", f"description: {_quote(mem.description)}", "metadata:"]
    metadata = dict(mem.metadata)
    metadata.update(extra_metadata or {})
    for key in ["type"] + [k for k in metadata if k != "type"]:
        if key in metadata:
            lines.append(f"  {key}: {_quote(str(metadata[key]))}")
    lines += ["---", "", mem.body, ""]
    return "\n".join(lines)


def title_of(mem):
    return mem.name.replace("-", " ").title()


# ---------------------------------------------------------------- marked blocks

def replace_block(text, block, begin=BEGIN, end=END):
    pat = re.compile(re.escape(begin) + r".*?" + re.escape(end), re.S)
    if pat.search(text):
        return pat.sub(lambda _: block, text, count=1)
    if text and not text.endswith("\n"):
        text += "\n"
    return text + ("\n" if text else "") + block + "\n"


def strip_block(text, begin=BEGIN, end=END):
    pat = re.compile(r"\n?" + re.escape(begin) + r".*?" + re.escape(end) + r"\n?", re.S)
    return pat.sub("\n", text).strip("\n") + "\n" if pat.search(text) else text


def strip_bank_blocks(text, slugs):
    """The named banks' blocks out of one document, other banks' left standing."""
    for slug in slugs:
        text = strip_block(text, begin_marker(slug), end_marker(slug))
    return text


# ---------------------------------------------------------------- artemis layout

def artemis_root(args):
    if args.root:
        return Path(args.root).expanduser()
    if os.environ.get("ARTEMIS_ROOT"):
        return Path(os.environ["ARTEMIS_ROOT"]).expanduser()
    return Path.home() / "Library" / "Application Support" / "Artemis"


def norm(name):
    return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")


def load_profiles(root):
    pfile = root / "profiles.json"
    if not pfile.is_file():
        fail(f"no profiles.json under {root} — pass --root or set ARTEMIS_ROOT")
    # utf-8-sig: Artemis writes this file through Node (no BOM), but a
    # profiles.json touched by PowerShell's `Set-Content -Encoding utf8`
    # arrives with one, and json.loads refuses it — which used to take down
    # doctor, pull and enable in one stroke.
    data = json.loads(pfile.read_text(encoding="utf-8-sig"))
    profiles = []
    for p in data.get("profiles", []):
        cdir = Path(p["configDir"])
        if cdir.is_dir():
            profiles.append({"label": p.get("label", cdir.name), "dir": cdir})
    if not profiles:
        fail(f"profiles.json under {root} lists no existing profiles")
    return profiles


def select_profiles(root, names):
    profiles = load_profiles(root)
    if not names:
        return profiles
    picked = []
    for want in names:
        matches = [p for p in profiles
                   if norm(want) in (norm(p["label"]), norm(p["dir"].name))]
        if not matches:
            known = ", ".join(sorted({p["dir"].name for p in profiles}))
            fail(f"no profile matches {want!r} (known: {known})")
        picked += [m for m in matches if m not in picked]
    return picked


def project_key(path):
    return re.sub(r"[^A-Za-z0-9]", "-", str(Path(path).resolve()))


def scope_entries(mem):
    """The repos a memory names in `applies_to`, or [] for an unscoped one."""
    raw = mem.metadata.get("applies_to", "").strip()
    return [e for e in re.split(r"[,\s]+", raw) if e] if raw else []


def scope_indexes(mem, key):
    """Should this memory appear in the MEMORY.md index of this project?

    Scoping filters the *index*, never the files: every memory is installed
    into every project's `memory/cerebro/` regardless, so wiki-links between
    memories always resolve and an agent whose task turns out to cross repos
    can still open anything by name. What `applies_to` decides is the only part
    that costs context at session start — the one line per memory in MEMORY.md.

    An entry is a repo directory name (`artemis`, `medusa_ordergroove_fe`), and
    it matches any project whose path ends in that directory. Matching runs in
    project-key space — the path with every non-alphanumeric flattened to `-` —
    because for `--all-projects` the key is all `pull` has; the original path is
    not recoverable from it. The consequence to document rather than fix: the
    key also flattens the boundaries *inside* a directory name, so an entry
    that is a dash-suffix of another repo's name (`brain` vs `telehealth-brain`)
    would over-match. Whole directory names, which is what the docs teach,
    cannot collide this way.
    """
    entries = scope_entries(mem)
    if not entries:
        return True
    key_l = key.lower()
    for entry in entries:
        norm = re.sub(r"[^A-Za-z0-9]", "-", entry).strip("-").lower()
        if norm and (key_l == norm or key_l.endswith("-" + norm)):
            return True
    return False


def self_project(repo):
    top = run_git(Path.cwd(), "rev-parse", "--show-toplevel")
    return Path(top) if top else Path.cwd()


def target_keys(profile, args, repo):
    if args.all_projects:
        pdir = profile["dir"] / "projects"
        keys = []
        for entry in sorted(pdir.iterdir()) if pdir.is_dir() else []:
            key = entry.name
            if not entry.is_dir():
                continue
            if SKIP_PROJECT_KEY.search(key) or key.startswith(("-private-", "-var-", "-tmp")):
                continue
            if args.exclude and re.search(args.exclude, key):
                continue
            keys.append(key)
        skey = project_key(self_project(repo))
        if skey not in keys:  # current project may not have a dir yet (first session)
            keys.append(skey)
        return keys
    projects = [Path(p) for p in args.project] if args.project else [self_project(repo)]
    return [project_key(p) for p in projects]


