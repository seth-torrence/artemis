        del mem.metadata["author"]
    dest = memory_dest(repo, mem)
    mem.path = dest
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(render_memory(mem), encoding="utf-8")
    print(f"created {dest}\nEdit the body, then run: bin/cerebro validate")


def bank_for_install(repo):
    """The memories `pull` will install: everything that validates, minus
    whatever would collide, with the rest announced and left out.

    Installing is an automatic act — Artemis runs `sync` at the start of every
    run — so it degrades rather than stops. It used to stop: any file with a
    validation error aborted the whole install, which was survivable while
    `memories/` was globbed one level deep, because that is all the bank's own
    tree ever held. Reading the tree recursively is what makes
    memories/<org>/<project>/ work, and it also hands the gate every stray
    `.md` anyone ever left in a subdirectory. One of those — a scratch file, a
    half-finished note, a name that collides with a flat memory — would take
    out the install, the CLAUDE.md refresh and every future sync, for a
    command the user never typed and about a file the previous version never
    mentioned.

    So the automatic path installs what is good and says on stderr what it
    skipped. Nothing is hidden by this: `status` counts validation errors from
    the same reading, so the pane still shows a bank with problems, and
    `validate` — which a person runs precisely to ask for judgment — keeps
    reporting everything and exiting 1.

    Collisions are decided by depth, shallowest first, then by path. An
    install flattens to <name>.md, so two files sharing a slug cannot both
    land; preferring the shallower one keeps the flat memory, which is the
    file that was being installed before the tree was read recursively."""
    results = load_bank(repo)

    # A duplicate-name error is about a pair of files and is settled below, on
    # depth. Every other error is the file's own and disqualifies it here.
    skipped, candidates = {}, []
    for path, mem, errors, _ in results:
        own = [e for e in errors if not e.startswith("duplicate name ")]
        if mem is None:
            skipped[path] = own or ["not a readable memory"]
        elif own:
            skipped[path] = own
        else:
            candidates.append((path, mem))

    taken = {}
    for path, mem in sorted(candidates, key=lambda c: (len(c[0].parts), str(c[0]))):
        winner = taken.get(mem.name)
        if winner is None:
            taken[mem.name] = path
        else:
            skipped[path] = [f"duplicate name {mem.name!r} — installing "
                             f"{os.path.relpath(winner, repo)} instead"]

    for path in sorted(skipped, key=str):
        for reason in skipped[path]:
            print(f"cerebro: skipped {os.path.relpath(path, repo)} — {reason}", file=sys.stderr)
    if skipped:
        print(f"cerebro: {len(skipped)} file(s) not installed — run `cerebro validate` for the "
              f"full report", file=sys.stderr)

    return [m for p, m, _, _ in results if m is not None and p not in skipped]


def pull_bank(repo, args):
    entry = bank_entry_for(repo)
    slug = entry["slug"]
    sub = bank_subdir(slug)
    bank = bank_for_install(repo)
    stamp = source_stamp(repo)
    today = datetime.date.today().isoformat()
    profiles = select_profiles(artemis_root(args), args.profile)
    synced = 0
    seen = set()
    extra = {"repo": str(repo), "source": stamp, "synced": today}
    if slug != LEGACY_SLUG:
        extra["bank"] = slug
    for profile in profiles:
        for key in target_keys(profile, args, repo):
            memdir = profile["dir"] / "projects" / key / "memory"
            if (memdir.resolve(), slug) in seen:  # profiles may symlink a shared projects store
                continue
            seen.add((memdir.resolve(), slug))
            cdir = memdir / sub
            # Every memory lands on disk; only the covered ones land in the
            # index. The index is what a session pays context for, so it lists
            # what this repo needs — while the files stay a complete mirror,
            # so wiki-links resolve and anything can be opened by name.
            indexed = [m for m in bank if scope_indexes(m, key)]
            elsewhere = len(bank) - len(indexed)
            index = [f"- [{title_of(m)}]({sub / (m.name + '.md')}) — {m.description}"
                     for m in indexed]
            if elsewhere:
                index.append(f"- …plus {elsewhere} memories scoped to other repos, on disk in "
                             f"{sub}/ — open by name, or `cerebro list` for all")
            block = (f"{begin_marker(slug)}\n<!-- Managed by `cerebro pull` from {repo} @ {stamp} "
                     f"({today}). Do not edit; rerun bin/cerebro pull to refresh. -->\n"
                     + "\n".join(index) + f"\n{end_marker(slug)}")
            if args.dry_run:
                print(f"would sync {len(bank)} memories -> {cdir} ({len(indexed)} indexed)")
                continue
            cdir.mkdir(parents=True, exist_ok=True)
            keep = {m.name + ".md" for m in bank}
            for old in cdir.glob("*.md"):
                if old.name not in keep:
                    old.unlink()
            for m in bank:
                if (memdir / (m.name + ".md")).exists():
                    print(f"warn  {profile['dir'].name}/{key}: personal memory {m.name}.md "
                          f"shadows a {slug} slug", file=sys.stderr)
                (cdir / (m.name + ".md")).write_text(render_memory(m, extra), encoding="utf-8")
            mfile = memdir / "MEMORY.md"
            text = mfile.read_text(encoding="utf-8") if mfile.is_file() else ""
            mfile.write_text(replace_block(text, block, begin_marker(slug), end_marker(slug)),
                             encoding="utf-8")
            synced += 1
            if not args.quiet:
                print(f"synced {len(bank)} memories -> {profile['dir'].name}/projects/{key} "
                      f"({len(indexed)} indexed)")
    print(f"{stamp}: {len(bank)} memories -> {synced} project(s) across "
          f"{len(profiles)} profile(s)" + (" [dry-run]" if args.dry_run else ""))


def cmd_pull(args):
    pull_bank(repo_root(), args)


def cmd_uninstall(args):
    repo = repo_root()
    slug = bank_entry_for(repo)["slug"]
    sub = bank_subdir(slug)
    removed = 0
    seen = set()
    for profile in select_profiles(artemis_root(args), args.profile):
        for key in target_keys(profile, args, repo):
            memdir = profile["dir"] / "projects" / key / "memory"
            if memdir.resolve() in seen:
                continue
            seen.add(memdir.resolve())
            cdir = memdir / sub
            if cdir.is_dir():
                for f in cdir.glob("*.md"):
                    f.unlink()
                try:
                    cdir.rmdir()
                    if slug != LEGACY_SLUG:
                        (memdir / "banks").rmdir()  # only when this was the last bank
                except OSError:
                    if cdir.is_dir():
                        print(f"warn  left non-empty {cdir}", file=sys.stderr)
                removed += 1
            mfile = memdir / "MEMORY.md"
            if mfile.is_file():
                text = strip_block(mfile.read_text(encoding="utf-8"),
                                   begin_marker(slug), end_marker(slug))
                if text.strip():
                    mfile.write_text(text, encoding="utf-8")
                else:
                    mfile.unlink()
    print(f"removed {slug} memories from {removed} project(s)")


SHIM_NAME = "cerebro"


def _path_dirs():
    return [Path(p) for p in os.environ.get("PATH", "").split(os.pathsep) if p]


def shim_target():
    """Where the `cerebro` shim belongs.

    Preference order is "already on PATH and writable", because a link in a
    directory the shell never searches is a file that fixes nothing. When no
    such directory exists we still answer `~/.local/bin` — it is the usual place
    for exactly this, creating it is harmless, and `doctor` will say it needs to
    go on PATH rather than the link silently doing nothing.

    `$CEREBRO_SHIM_DIR` overrides the search outright. This is the one piece of
    cerebro whose destination is decided by the ambient environment rather than
    by an argument, which makes it the one piece that cannot be sandboxed by
    `--root` or by `$HOME`: the test suite that exercises `enable` would
    otherwise write into whatever writable PATH directory the machine running it
    happens to have — `~/.local/bin` on a developer's laptop, `/usr/local/bin`
    on a CI runner — and leave the link behind, pointing at a repository that no
    longer exists. A test run must not be able to uninstall the tool.
    """
    override = os.environ.get("CEREBRO_SHIM_DIR")
    if override:
        return Path(override) / SHIM_NAME
    home = Path.home()
    preferred = [home / ".local" / "bin", Path("/usr/local/bin"), home / "bin"]
    on_path = _path_dirs()
    for d in preferred:
        if d in on_path and d.is_dir() and os.access(d, os.W_OK):
            return d / SHIM_NAME
    return home / ".local" / "bin" / SHIM_NAME


def install_shim(repo, quiet=False):
    """Put `cerebro` on PATH as a link to this checkout.

    The agent-facing prompt teaches the bare verb, and a bare verb that is not
    on PATH is the difference between a memory getting written and an agent
    quietly deciding the bank is not available. Best-effort by design: a machine
    where nothing is writable still has a working CLI at its full path, which is
    what the prompt's fallback clause is for.
    """
    cli = (repo / "bin" / SHIM_NAME).resolve()
    dest = shim_target()
    try:
        dest.parent.mkdir(parents=True, exist_ok=True)
        if os.name == "nt":
            # A symlink needs a privilege ordinary Windows accounts lack
            # (WinError 1314), and a shebang file is nothing to CreateProcess
            # anyway. A .cmd launcher is the native equivalent: tiny, found via
            # PATHEXT, exit code passed through, pointing at the bank's copy.
            dest = dest.with_name(SHIM_NAME + ".cmd")
            body = "@echo off\r\nrem cerebro shim - managed by `cerebro enable`\r\npy -3 \"%s\" %%*\r\n" % cli
            if dest.exists():
                current = dest.read_text(encoding="utf-8-sig", errors="replace")
                if "cerebro shim" not in current:
                    if not quiet:
                        print(f"warn  {dest} exists and is not cerebro's shim — "
                              f"leaving it alone; agents will use {cli}", file=sys.stderr)
                    return None
                if current == body:
                    return dest
            dest.write_text(body, encoding="ascii")
            return dest
        if dest.is_symlink():
            if dest.resolve() == cli:
                return dest
            dest.unlink()
        elif dest.exists():
            # Something that is not ours owns the name. Leave it alone and say
            # so — clobbering a stranger's binary to install a memory bank is
            # never the right trade.
            if not quiet:
                print(f"warn  {dest} exists and is not a link to this checkout — "
                      f"leaving it alone; agents will use {cli}", file=sys.stderr)
            return None
        dest.symlink_to(cli)
    except OSError as exc:
        if not quiet:
            print(f"warn  could not put cerebro on PATH ({exc}) — agents will use {cli}",
                  file=sys.stderr)
        return None
    if not quiet:
        print(f"cerebro: linked {dest} -> {cli}")
    return dest


def remove_shim():
    """Drop the shim, but only when it is unmistakably ours."""
    dest = shim_target()
    try:
        if os.name == "nt":
            dest = dest.with_name(SHIM_NAME + ".cmd")
            if dest.is_file() and "cerebro shim" in dest.read_text(encoding="utf-8-sig",
                                                                   errors="replace"):
                dest.unlink()
                return dest
            return None
        if dest.is_symlink() and dest.resolve().name == SHIM_NAME \
                and dest.resolve().parent.name == "bin":
            dest.unlink()
            return dest
    except OSError:
        pass
    return None


def hook_command(repo):
    """One hook syncs everything: `sync` iterates every configured bank, so the
    hook anchors on a single CLI — the anchor bank's embedded copy when it has
    one (stable path, self-updating), else the copy performing the enable."""
    return f'"{bank_cli(repo)}" sync --quiet'


def _is_our_hook_group(group):
    # Loose on purpose: the CLI may live at `<bank>/bin/cerebro` or at a
    # host-app's vendored path, and a stale hook we fail to recognise is a
    # duplicate sync forever.
    return any("cerebro" in h.get("command", "") and " sync" in h.get("command", "")
               for h in group.get("hooks", []))


def install_hook(profile, repo):
    sfile = profile["dir"] / "settings.json"
    try:
        data = json.loads(sfile.read_text(encoding="utf-8")) if sfile.is_file() else {}
    except json.JSONDecodeError:
        print(f"warn  {sfile} is not valid JSON — skipping hook install", file=sys.stderr)
        return
    groups = data.setdefault("hooks", {}).setdefault("SessionStart", [])
    groups[:] = [g for g in groups if not _is_our_hook_group(g)]
    groups.append({"matcher": "startup|resume|clear",
                   "hooks": [{"type": "command", "command": hook_command(repo), "timeout": 30}]})
    sfile.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def remove_hook(profile):
    sfile = profile["dir"] / "settings.json"
    if not sfile.is_file():
        return
    try:
        data = json.loads(sfile.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        return
    groups = data.get("hooks", {}).get("SessionStart", [])
    groups[:] = [g for g in groups if not _is_our_hook_group(g)]
    if not groups:
        data.get("hooks", {}).pop("SessionStart", None)
    if not data.get("hooks"):
        data.pop("hooks", None)
    sfile.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")


def do_enable(profile, repo, stamp, entry, banks, anchor_repo):
    claude = profile["dir"] / "CLAUDE.md"
    text = claude.read_text(encoding="utf-8") if claude.is_file() else ""
    claude.write_text(replace_block(text, profile_block(repo, stamp, entry),
                                    begin_marker(entry["slug"]), end_marker(entry["slug"])),
                      encoding="utf-8")
    cmds = profile["dir"] / "commands"
    cmds.mkdir(parents=True, exist_ok=True)
    (cmds / "cerebro.md").write_text(command_file(banks), encoding="utf-8")
    install_hook(profile, anchor_repo)


def cmd_enable(args):
    targets = addressed_banks()
    configured = load_banks()
    wanted = {entry["slug"] for entry in targets}
    # Enabling is also consent, recorded in the config where every consumer —
    # the hook's sync loop, a host app's settings pane — reads it.
    if configured and any(b["slug"] in wanted and not b["enabled"] for b in configured):
        for bank in configured:
            if bank["slug"] in wanted:
                bank["enabled"] = True
        save_banks(configured)
        configured = load_banks()
        targets = [b for b in configured if b["slug"] in wanted]
    # The command file describes every bank that is on, not only the ones this
    # invocation touched — it is one file, shared by all of them.
    active = [b for b in configured if b["enabled"]] if configured else targets
    anchor = default_bank(active) or targets[0]
    anchor_repo = Path(anchor["path"]).expanduser().resolve()
    # Once, not per profile: the shim is a per-machine fact.
    install_shim(anchor_repo)
    for profile in select_profiles(artemis_root(args), args.profile):
        for entry in targets:
            repo = Path(entry["path"]).expanduser()
            if not is_bank(repo):
                print(f"warn  {entry['slug']}: {repo} is not a memory bank — skipped", file=sys.stderr)
                continue
            do_enable(profile, repo.resolve(), source_stamp(repo), entry, active, anchor_repo)
        print(f"enabled for profile {profile['dir'].name} "
              f"(CLAUDE.md block + /cerebro command + session-start sync hook)")


def cmd_disable(args):
    targets = addressed_banks()
    configured = load_banks()
    wanted = {entry["slug"] for entry in targets}
    if configured and any(b["slug"] in wanted and b["enabled"] for b in configured):
        for bank in configured:
            if bank["slug"] in wanted:
                bank["enabled"] = False
        save_banks(configured)
        configured = load_banks()
    remaining = [b for b in configured if b["enabled"]]
    # With nothing left on, the per-machine wiring goes too. A partial disable
    # keeps the shim and hook: they serve the banks still enabled.
    whole = not remaining
    if whole:
        dropped = remove_shim()
        if dropped is not None:
            print(f"cerebro: removed {dropped}")
    strip = set(wanted)
    if whole:
        strip |= {b["slug"] for b in configured} | {LEGACY_SLUG}
    for profile in select_profiles(artemis_root(args), args.profile):
        claude = profile["dir"] / "CLAUDE.md"
        if claude.is_file():
            claude.write_text(strip_bank_blocks(claude.read_text(encoding="utf-8"), strip),
                              encoding="utf-8")
        cmd = profile["dir"] / "commands" / "cerebro.md"
        if cmd.is_file() and CMD_MARKER in cmd.read_text(encoding="utf-8"):
            if whole:
                cmd.unlink()
            else:
                cmd.write_text(command_file(remaining), encoding="utf-8")
        if whole:
            remove_hook(profile)
        print(f"disabled for profile {profile['dir'].name}")


def _bank_health(repo):
    results = load_bank(repo)
    mirrored = len(load_mirror_trees(repo))
    # `memories` stays the headline number a pane shows; `own` is what pull
    # installs and validation gates. Mirror content is browse-only and must
    # never contribute errors — it is not this bank's to fix.
    return {"memories": len(results) + mirrored,
            "own": len(results),
            "mirrored": mirrored,
            "errors": sum(len(e) for _, _, e, _ in results),
            "warnings": sum(len(w) for _, _, _, w in results)}


def _scan_install(cdir):
    """One installed mirror: how many files, stamped from which source."""
    files = list(cdir.glob("*.md"))
    src = None
    if files:
        m = re.search(r"source: (\S+)", files[0].read_text(encoding="utf-8"))
        src = m.group(1) if m else None
    return {"memories": len(files), "source": src}


def gather_status(repo, root):
    """
    The addressed bank in the shape `status --json` has always had — a consumer
    written against the single-bank CLI keeps parsing — plus a `banks` array
    describing every configured bank, which is the shape multi-bank consumers
    should read instead.
    """
    configured = load_banks()
    default = default_bank(configured)
    data = {
        "repo": str(repo),
        "source": source_stamp(repo),
        "remote": run_git(repo, "remote", "get-url", "origin") or None,
        "artemis_root": str(root),
        "bank": _bank_health(repo),
        "banks": [],
        "profiles": [],
    }
    for entry in configured:
        path = Path(entry["path"]).expanduser()
        exists = is_bank(path)
        data["banks"].append({
            "slug": entry["slug"],
            "path": str(path),
            "role": entry["role"],
            "enabled": entry["enabled"],
            "default": default is not None and entry["slug"] == default["slug"],
            "exists": exists,
            "source": source_stamp(path) if exists else None,
            "remote": (run_git(path, "remote", "get-url", "origin") or None) if exists else None,
            "bank": _bank_health(path) if exists else {"memories": 0, "errors": 0, "warnings": 0},
        })
    slugs = [b["slug"] for b in configured] or [LEGACY_SLUG]
    seen_roots = {}
    for profile in load_profiles(root):
        cfile = profile["dir"] / "CLAUDE.md"
        ctext = cfile.read_text(encoding="utf-8") if cfile.is_file() else ""
        # Wired means *any* bank's block is present — the legacy unprefixed one
        # or a namespaced `cerebro:<slug>:` marker. Checking only the legacy
        # marker made every multi-bank profile read as "not enabled" forever.
        enabled = BEGIN in ctext or any(begin_marker(s) in ctext for s in slugs)
        sfile = profile["dir"] / "settings.json"
        hooked = sfile.is_file() and "cerebro" in sfile.read_text(encoding="utf-8")
        prof = {"name": profile["dir"].name, "label": profile["label"],
                "enabled": enabled, "hook": hooked,
                "banks": {slug: begin_marker(slug) in ctext for slug in slugs},
                "projects": [], "shared_with": None}
        pdir = profile["dir"] / "projects"
        proot = pdir.resolve()
        if proot in seen_roots:
            prof["shared_with"] = seen_roots[proot]
        else:
            seen_roots[proot] = profile["dir"].name
            for entry in sorted(pdir.iterdir()) if pdir.is_dir() else []:
                cdir = entry / "memory" / "cerebro"
                if cdir.is_dir():
                    prof["projects"].append({"key": entry.name, **_scan_install(cdir)})
                bdir = entry / "memory" / "banks"
                for sub in sorted(bdir.iterdir()) if bdir.is_dir() else []:
                    if sub.is_dir():
                        prof["projects"].append(
                            {"key": entry.name, "bank": sub.name, **_scan_install(sub)})
        data["profiles"].append(prof)
    return data


def cmd_status(args):
    repo = repo_root()
    data = gather_status(repo, artemis_root(args))
    if args.json:
        print(json.dumps(data, indent=2))
