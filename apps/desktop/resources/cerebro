def cmd_validate(args):
    repo = repo_root()
    paths = [Path(p) for p in args.paths] if args.paths else None
    results = load_bank(repo, paths)
    n_err = n_warn = 0
    for path, _, errors, warnings in results:
        rel = os.path.relpath(path, repo)
        for e in errors:
            print(f"ERROR {rel}: {e}")
        for w in warnings:
            print(f"warn  {rel}: {w}")
        n_err += len(errors)
        n_warn += len(warnings)
    print(f"{len(results)} memories checked: {n_err} errors, {n_warn} warnings")
    if n_err or (args.strict and n_warn):
        sys.exit(1)


def cmd_new(args):
    repo = repo_root()
    if not SLUG_RE.fullmatch(args.name):
        fail(f"{args.name!r} is not a kebab-case slug (e.g. deploy-approval-flow)")
    existing = find_memory_file(repo, args.name)
    if existing is not None:
        fail(f"{existing} already exists")
    today = datetime.date.today().isoformat()
    body = ("<the fact — atomic, durable, absolute dates>\n\n"
            "**Why:** <why this matters to the team>\n"
            "**How to apply:** <what to do differently because of it>\n"
            if args.type in ("feedback", "project") else
            "<the fact — atomic, durable, absolute dates>\n")
    metadata = {"type": args.type, "added": today, "author": args.author or ""}
    if args.applies_to:
        entries = [e for chunk in args.applies_to for e in re.split(r"[,\s]+", chunk) if e]
        metadata["applies_to"] = ", ".join(entries)
    apply_grouping(repo, metadata, args)
    mem = Memory(None, args.name, args.description or "<one line: when is this relevant?>",
                 metadata, body.strip("\n"))
