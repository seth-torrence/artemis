{
  "name": "@rx-artemis/desktop",
  "version": "2.8.0",
  "private": true,
  "description": "Artemis desktop application \u2014 Electron main, preload bridge and React renderer.",
  "author": {
    "name": "Seth Torrence",
    "email": "seth@storrence.dev"
  },
  "homepage": "https://github.com/seth-torrence/artemis",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "package": "pnpm -w run build:libs && pnpm run build && electron-builder --dir",
    "dist": "pnpm -w run build:libs && pnpm run build && electron-builder --publish never",
    "dist:beta": "ARTEMIS_FLAVOUR=Beta pnpm -w run build:libs && ARTEMIS_FLAVOUR=Beta pnpm run build && electron-builder --publish never --config.productName='Artemis (Beta)' --config.appId=dev.artemis.app.beta --config.directories.output=release-beta --config.mac.artifactName='Artemis-Beta-${version}-${arch}-mac.${ext}'",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "icon:build": "sh build/icon-build.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.258",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@rx-artemis/core": "workspace:*",
    "@rx-artemis/protocol": "workspace:*",
    "@rx-artemis/transcript": "workspace:*",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.12.0",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@tiptap/extensions": "3.30.0",
    "@tiptap/pm": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.7",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "0.9.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  }
}
