{
  "name": "rx-artemis",
  "private": true,
  "description": "Artemis \u2014 a desktop UI for agentic coding CLIs.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:libs && pnpm --filter @rx-artemis/desktop dev",
    "build": "pnpm run build:libs && pnpm --filter @rx-artemis/desktop build",
    "build:libs": "tsc -b packages/protocol packages/transcript packages/core",
    "typecheck": "tsc -b --pretty",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty",
    "smoke": "pnpm run build:libs && tsx scripts/smoke.ts",
    "acp:probe": "tsx scripts/acp-probe.ts",
    "codex:smoke": "pnpm run build:libs && tsx scripts/smoke-codex.ts",
    "opencode:smoke": "tsx scripts/opencode-smoke.ts",
    "release": "tsx scripts/release.ts",
    "next-version": "tsx scripts/nextVersion.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "test": "pnpm -r --if-present test && vitest run --root scripts --passWithNoTests",
    "test:watch": "pnpm -r --if-present --parallel test:watch",
    "clean": "tsc -b --clean && rimraf --glob \"**/dist\" \"**/out\" \"**/.tsbuild\" \"**/*.tsbuildinfo\"",
    "local:smoke": "tsx scripts/local-smoke.ts",
    "sandbox:check": "tsx scripts/sandbox-check.ts",
    "opencode:attach": "tsx scripts/opencode-attach.ts",
    "tui": "tsc -b apps/tui && node apps/tui/dist/main.js"
  },
  "devDependencies": {
    "@rx-ventures/artemis-sdk": "workspace:*",
    "@rx-artemis/core": "workspace:*",
    "@rx-artemis/protocol": "workspace:*",
    "@types/node": "^26.2.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  }
}
