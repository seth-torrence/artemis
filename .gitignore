node_modules/
dist/
out/
release/
# electron-builder's output for `dist:beta`. Named separately from `release/`
# so a beta build cannot overwrite the artifacts of a real one — which also
# means it needs its own line here, and did not get one until 972MB of dmg was
# committed by a `git add -A`.
release-beta/
build/
# …but electron-builder's buildResources (app icons) are source, not output.
!apps/desktop/build/
.tsbuild/
*.tsbuildinfo

# Vite / electron-vite
.vite/
apps/desktop/out/

# Editors / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local env. Artemis keeps real secrets in the OS keychain via safeStorage, never
# in files, but keep this ignored so nobody is tempted.
.env
.env.*
!.env.example

# Local test/profile scratch data
.artemis/
.artemis-dev/
test_workspace/
coverage/

# Worktrees created by other sessions
.claude/worktrees/

# Python bytecode from the design scripts.
__pycache__/
